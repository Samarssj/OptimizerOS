# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: MongoDB Atlas connection string (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/code_optimizer?retryWrites=true&w=majority)
MONGODB_URI="mongodb+srv://..."
# Optional; defaults to code_optimizer
MONGODB_DB_NAME="code_optimizer"

# JWT_SECRET: Secret for signing JWT authentication tokens
JWT_SECRET="your_jwt_secret_key"
